# Supabase — get from project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth — https://console.cloud.google.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=taylor@whatsinababyname.com

# Cal.com — https://cal.com/settings/developer/api-keys
CAL_COM_API_KEY=

# Apollo (paid tier — leave blank until key arrives)
APOLLO_API_KEY=

# Hunter.io — email finder + SMTP verifier (~$34/mo for 500 verifications)
# Leave blank: hunterFindEmails() and hunterVerify() become no-ops.
HUNTER_API_KEY=

# Modash (paid tier — leave blank until key arrives)
MODASH_API_KEY=

# Listen Notes (paid tier — leave blank until key arrives)
LISTEN_NOTES_API_KEY=

# SimilarWeb (paid tier — leave blank until key arrives)
SIMILARWEB_API_KEY=
